{
  "name": "yarn-plugin-unused-resolutions",
  "description": "A Yarn plugin that checks for unused resolutions in package.json",
  "version": "0.1.2",
  "private": true,
  "main": "./src/index.ts",
  "license": "MIT",
  "scripts": {
    "build": "yarn clean && builder build plugin",
    "build:debug": "builder build plugin --source-map --no-minify --metafile",
    "clean": "rimraf bundles",
    "format": "prettier --write .",
    "test": "node test.js",
    "postinstall": "yarn husky"
  },
  "dependencies": {
    "@yarnpkg/cli": "^4.18.0",
    "@yarnpkg/core": "^4.7.0",
    "@yarnpkg/fslib": "^3.1.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@yarnpkg/builder": "4.2.4",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  },
  "resolutions": {
    "@yarnpkg/core/tar": "7.5.21"
  },
  "packageManager": "yarn@4.18.1"
}
